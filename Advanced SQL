/* ============================================================
   Q6. CTE: total revenue per product (Price x Quantity),
       return only products where revenue > 3000
   ============================================================
   Step 1: Join Products and Sales on ProductID.
   Step 2: Calculate revenue = Price * Quantity, summed per product.
   Step 3: Put that logic in a CTE named ProductRevenue.
   Step 4: Select from the CTE and filter revenue > 3000.
   ============================================================ */

WITH ProductRevenue AS (
    SELECT
        p.ProductID,
        p.ProductName,
        SUM(p.Price * s.Quantity) AS TotalRevenue
    FROM Products p
    JOIN Sales s ON p.ProductID = s.ProductID
    GROUP BY p.ProductID, p.ProductName
)
SELECT ProductID, ProductName, TotalRevenue
FROM ProductRevenue
WHERE TotalRevenue > 3000;

/* Expected output (all 4 products qualify):
   ProductID | ProductName | TotalRevenue
   1         | Keyboard    | 4800.00   (1200 x 4)
   2         | Mouse       | 8000.00   (800 x 10)
   3         | Chair       | 5000.00   (2500 x 2)
   4         | Desk        | 5500.00   (5500 x 1)
*/



/* ============================================================
   Q7. View vw_CategorySummary: Category, TotalProducts,
       AveragePrice
   ============================================================
   Step 1: Group the Products table by Category.
   Step 2: COUNT products and take AVG of price for each group.
   Step 3: Wrap the query in CREATE VIEW.
   Step 4: Query the view to check the result.
   ============================================================ */

CREATE OR REPLACE VIEW vw_CategorySummary AS
SELECT
    Category,
    COUNT(*)   AS TotalProducts,
    AVG(Price) AS AveragePrice
FROM Products
GROUP BY Category;

SELECT * FROM vw_CategorySummary;

/* Expected output:
   Category    | TotalProducts | AveragePrice
   Electronics | 2             | 1000.000000
   Furniture   | 2             | 4000.000000
*/



/* ============================================================
   Q8. Updatable view (ProductID, ProductName, Price) and
       update the price of ProductID = 1 through the view
   ============================================================
   Step 1: Create a simple view on ONE table with plain columns
           (no GROUP BY / aggregates), so it is updatable.
   Step 2: Run UPDATE on the view (not on the table).
   Step 3: Check that the base table changed too.
   ============================================================ */

CREATE OR REPLACE VIEW vw_ProductPrice AS
SELECT ProductID, ProductName, Price
FROM Products;

-- Update through the view (new price chosen as 1500)
UPDATE vw_ProductPrice
SET Price = 1500
WHERE ProductID = 1;

-- Verify in the view and in the base table
SELECT * FROM vw_ProductPrice WHERE ProductID = 1;
SELECT * FROM Products        WHERE ProductID = 1;

/* Expected output:
   ProductID | ProductName | Price
   1         | Keyboard    | 1500.00
*/



/* ============================================================
   Q9. Stored procedure: accepts a category name and returns
       all products in that category
   ============================================================
   Step 1: Change the delimiter so MySQL does not end the
           statement at the first semicolon inside the body.
   Step 2: Create the procedure with an IN parameter.
   Step 3: Use the parameter in a SELECT ... WHERE Category = ...
   Step 4: Restore the delimiter and call the procedure.
   ============================================================ */

DROP PROCEDURE IF EXISTS GetProductsByCategory;

DELIMITER $$

CREATE PROCEDURE GetProductsByCategory(IN p_category VARCHAR(50))
BEGIN
    SELECT ProductID, ProductName, Category, Price
    FROM Products
    WHERE Category = p_category;
END $$

DELIMITER ;

-- Call the procedure
CALL GetProductsByCategory('Electronics');
CALL GetProductsByCategory('Furniture');

/* Expected output for 'Electronics':
   ProductID | ProductName | Category    | Price
   1         | Keyboard    | Electronics | 1500.00  (1200 if Q8 not run)
   2         | Mouse       | Electronics | 800.00
*/



/* ============================================================
   Q10. AFTER DELETE trigger on Products that archives deleted
        rows into ProductArchive
        (ProductID, ProductName, Category, Price, DeletedAt)
   ============================================================
   Step 1: Create the archive table ProductArchive with a
           DeletedAt column that defaults to the current time.
   Step 2: Create an AFTER DELETE trigger on Products.
   Step 3: Inside the trigger, use OLD.column to read the values
           of the row that was just deleted and INSERT them into
           ProductArchive.
   Step 4: Test it by deleting a product.
   ============================================================ */

-- Step 1: Archive table
DROP TABLE IF EXISTS ProductArchive;

CREATE TABLE ProductArchive (
    ProductID   INT,
    ProductName VARCHAR(100),
    Category    VARCHAR(50),
    Price       DECIMAL(10,2),
    DeletedAt   TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

-- Step 2 & 3: Trigger
DROP TRIGGER IF EXISTS trg_ProductArchive_AfterDelete;

DELIMITER $$

CREATE TRIGGER trg_ProductArchive_AfterDelete
AFTER DELETE ON Products
FOR EACH ROW
BEGIN
    INSERT INTO ProductArchive (ProductID, ProductName, Category, Price, DeletedAt)
    VALUES (OLD.ProductID, OLD.ProductName, OLD.Category, OLD.Price, NOW());
END $$

DELIMITER ;

-- Step 4: Test
-- Products 1-4 have rows in Sales, so the foreign key blocks deleting them.
-- Insert a new product with no sales, then delete it.
INSERT INTO Products VALUES (5, 'Monitor', 'Electronics', 9000);

DELETE FROM Products WHERE ProductID = 5;

SELECT * FROM ProductArchive;

/* Expected output:
   ProductID | ProductName | Category    | Price   | DeletedAt
   5         | Monitor     | Electronics | 9000.00 | (current date and time)
*/
